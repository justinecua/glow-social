# Glow (monorepo root). backend/ and frontend/ have their own .gitignore.

# Secrets, anywhere in the repo (templates are allowed)
.env
.env.*
!.env.example

# Dependencies and virtual environments
node_modules/
backend/env/
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]

# Build output, uploads, collected static files
frontend/dist/
backend/media/
backend/staticfiles/

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local Claude Code files
.claude/settings.local.json
CLAUDE.md

# Local test credentials (contains passwords)
test_accounts.txt
