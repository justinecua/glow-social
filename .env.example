# Compose-level settings (copy to .env). App secrets live in backend/.env.
DB_NAME=glow
DB_USER=glow
DB_PASSWORD=glow

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Baked into the frontend bundle at build time
VITE_HOST=http://localhost:8000
VITE_WS_HOST=ws://localhost:8000

# Production only (docker-compose.prod.yml)
# DB_USER=
# DB_PASSWORD=
# DB_NETWORK=postgre16db_default   # network of the postgres16-new container
# HTTP_PORT=127.0.0.1:8100
# PUBLIC_URL=https://glowph.social
# PUBLIC_WS_URL=wss://glowph.social
